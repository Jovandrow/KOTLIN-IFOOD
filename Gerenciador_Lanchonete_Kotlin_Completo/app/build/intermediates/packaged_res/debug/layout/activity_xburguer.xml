<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X-Burguer"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preço de acordo com o sabor"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolha o sabor (só um):"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgSabor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbSabor0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="X-Bacon - R$ 14,00" />

            <RadioButton
                android:id="@+id/rbSabor1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="X-Salada - R$ 12,00" />

            <RadioButton
                android:id="@+id/rbSabor2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="X-Tudo - R$ 17,00" />

            <RadioButton
                android:id="@+id/rbSabor3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="X-Frango - R$ 13,00" />

            <RadioButton
                android:id="@+id/rbSabor4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="X-Calabresa - R$ 13,00" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolha os adicionais:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbBacon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bacon (+R$ 2,00)" />

        <CheckBox
            android:id="@+id/cbOvo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ovo (+R$ 1,50)" />

        <CheckBox
            android:id="@+id/cbQueijoExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Queijo Extra (+R$ 1,50)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantidade:"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnMenos"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="-" />

            <TextView
                android:id="@+id/tvQuantidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

            <Button
                android:id="@+id/btnMais"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="+" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAdicionarCarrinho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADICIONAR AO CARRINHO"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VOLTAR"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
