<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="O que você vai pedir hoje?"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_hotdog"
                    android:contentDescription="Hot Dog" />

                <Button
                    android:id="@+id/btnHotDog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="HOT DOG" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_xburguer"
                    android:contentDescription="X-Burguer" />

                <Button
                    android:id="@+id/btnXBurguer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="X-BURGUER" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_pizza"
                    android:contentDescription="Pizza" />

                <Button
                    android:id="@+id/btnPizza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PIZZA" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_refrigerante"
                    android:contentDescription="Refrigerante" />

                <Button
                    android:id="@+id/btnRefrigerante"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="REFRIGERANTE" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgCoxinha"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Coxinha" />

                <Button
                    android:id="@+id/btnCoxinha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="COXINHA" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgPastel"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Pastel" />

                <Button
                    android:id="@+id/btnPastel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASTEL" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgBatataFrita"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Batata Frita" />

                <Button
                    android:id="@+id/btnBatataFrita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BATATA FRITA" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgPaoDeQueijo"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Pão de Queijo" />

                <Button
                    android:id="@+id/btnPaoDeQueijo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PÃO DE QUEIJO" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgSuco"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="Suco de Laranja" />

                <Button
                    android:id="@+id/btnSuco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SUCO DE LARANJA" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgMilkshake"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_milkshake"
                    android:contentDescription="Milkshake" />

                <Button
                    android:id="@+id/btnMilkshake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MILKSHAKE" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnCarrinho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VER CARRINHO"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSobre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SOBRE" />

    </LinearLayout>
</ScrollView>
