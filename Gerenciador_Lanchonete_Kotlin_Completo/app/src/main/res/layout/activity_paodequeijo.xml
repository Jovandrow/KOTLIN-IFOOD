<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pão de Queijo"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preço de acordo com o sabor"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolha o sabor (só um):"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgSabor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbSabor0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Tradicional - R$ 6,00" />

            <RadioButton
                android:id="@+id/rbSabor1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Orégano - R$ 6,50" />

            <RadioButton
                android:id="@+id/rbSabor2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Presunto - R$ 8,00" />

            <RadioButton
                android:id="@+id/rbSabor3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Calabresa - R$ 8,00" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolha os recheios e adicionais:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/cbCatupiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recheado com Catupiry (+R$ 2,00)" />

        <CheckBox
            android:id="@+id/cbGoiabada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recheado com Goiabada (+R$ 2,00)" />

        <CheckBox
            android:id="@+id/cbPorcaoGrande"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Porção Grande (+R$ 3,00)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quantidade:"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnMenos"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="-" />

            <TextView
                android:id="@+id/tvQuantidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingStart="24dp"
                android:paddingEnd="24dp" />

            <Button
                android:id="@+id/btnMais"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="+" />
        </LinearLayout>

        <Button
            android:id="@+id/btnAdicionarCarrinho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADICIONAR AO CARRINHO"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VOLTAR"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
